classDiagram
    direction LR

    class CallCenterParticipant {
        <<abstract>>
        -String participantId
        #String displayName
        #CallCenterParticipant(participantId: String, displayName: String)
        +getParticipantId() String
        +getDisplayName() String
    }
    class Client {
        -String email
        -String phoneNumber
        +Client(participantId: String, displayName: String, email: String, phoneNumber: String)
        +getDisplayName() String
        +getEmail() String
        +getPhoneNumber() String
        +requestCallback(callId: String, operator: Operator, telephonyService: TelephonyService) Call
        +requestCallback(callId: String, preferredTime: String, operator: Operator, telephonyService: TelephonyService) Call
        +receiveSummary(summary: ConversationSummary) void
    }
    class Operator {
        -String operatorStatus
        +Operator(participantId: String, displayName: String, operatorStatus: String)
        +getDisplayName() String
        +handleCall(call: Call, script: ConversationScript) void
        +isAvailable() boolean
        +getOperatorStatus() String
    }
    class Supervisor {
        -String supervisorCode
        +Supervisor(participantId: String, displayName: String, supervisorCode: String)
        +getDisplayName() String
        +evaluate(recording: CallRecording, call: Call) QualityEvaluation
        +getSupervisorCode() String
    }
    class ConversationScript {
        <<interface>>
        +executeStep(stepNumber: int) String
        +getStepCount() int
        +getScriptName() String
    }
    class StandardConversationScript {
        -String scriptName
        -List~String~ steps
        +StandardConversationScript(scriptName: String, steps: List~String~)
        +getScriptName() String
        +executeStep(stepNumber: int) String
        +getStepCount() int
    }
    class Call {
        -String callId
        -Client client
        -Operator operator
        -String state
        -TelephonyService telephonyService
        -CallRecording recording
        -QualityEvaluation qualityEvaluation
        -ConversationSummary summary
        +Call(callId: String, client: Client, operator: Operator, telephonyService: TelephonyService)
        +rejectRequest() void
        +start() boolean
        +completeAndRecord() CallRecording
        +saveEvaluation(evaluation: QualityEvaluation) void
        +failEvaluation() void
        +saveSummary(summary: ConversationSummary) void
        +confirmSummarySent(success: boolean) void
        +getCallId() String
        +getState() String
        +getClient() Client
        +getOperator() Operator
        +getRecording() CallRecording
        +getQualityEvaluation() QualityEvaluation
        +getSummary() ConversationSummary
    }
    class TelephonyService {
        -String serviceName
        +TelephonyService(serviceName: String)
        +startCall(callId: String) boolean
        +endCall(callId: String) boolean
        +getServiceName() String
    }
    class CallRecording {
        -String recordingId
        -int duration
        -LocalDateTime createdAt
        +CallRecording(recordingId: String, duration: int, createdAt: LocalDateTime)
        +listen() String
        +getRecordingId() String
        +getDuration() int
        +getCreatedAt() LocalDateTime
    }
    class QualityEvaluation {
        -String evaluationId
        -int score
        -String feedback
        +QualityEvaluation(evaluationId: String, score: int, feedback: String)
        +getResult() String
        +getEvaluationId() String
        +getScore() int
        +getFeedback() String
    }
    class ConversationSummary {
        -String summaryId
        -String content
        -LocalDateTime preparedAt
        +ConversationSummary(summaryId: String, content: String, preparedAt: LocalDateTime)
        +getContent() String
        +getSummaryId() String
        +getPreparedAt() LocalDateTime
    }
    class EmailService {
        -String serviceName
        +EmailService(serviceName: String)
        +sendSummary(client: Client, summary: ConversationSummary) boolean
        +getServiceName() String
    }
    class ConsoleEncoding {
        <<utility>>
        -ConsoleEncoding()
        +configureUtf8() void
    }

    CallCenterParticipant <|-- Client
    CallCenterParticipant <|-- Operator
    CallCenterParticipant <|-- Supervisor
    ConversationScript <|.. StandardConversationScript
    Operator ..> ConversationScript : uses
    Call ..> TelephonyService : injected instance
    Call *-- "0..1" CallRecording : owns
    Call "1" --> "0..1" QualityEvaluation : stores
    Call "1" --> "0..1" ConversationSummary : stores
    Client "1" --> "0..*" Call : requests
    Operator "1" --> "0..*" Call : handles
    Supervisor ..> CallRecording : listens to
    Supervisor ..> QualityEvaluation : creates
    EmailService ..> Client : delivers to
    EmailService ..> ConversationSummary : sends

    note for CallCenterParticipant "getParticipantId() є final; getDisplayName() визначається спеціалізаціями"
    note for Client "getDisplayName() перевизначено; requestCallback() перевантажено для двох сигнатур"
    note for Operator "getDisplayName() перевизначено"
    note for Supervisor "getDisplayName() перевизначено"
    note for TelephonyService "Симуляція телефонії; зовнішніх викликів немає"
    note for EmailService "Симуляція електронної пошти; успіх лише після підтвердження"
    note for ConsoleEncoding "Технічна утиліта, не предметна сутність; статично налаштовує UTF-8 для стандартних потоків консолі"
